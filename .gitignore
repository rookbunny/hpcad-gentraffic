# generated config holds a password and internal addresses. The template it is
# generated from (config/config.example.yaml) stays tracked.
config/config.yaml

# per-run capture directories, ground-truth logs, pcaps. The directory itself,
# its README and the naming template are tracked, so the expected layout is
# visible before the first run; the runs themselves never are. Note the pattern
# is logs/* rather than logs/: git does not descend into an ignored directory,
# so the exceptions below would not be reachable.
logs/*
!logs/README.md
!logs/_TEMPLATE_R0000-S00000_logs/

# run pointer (repo root) and the systemd unit's optional seed env file
.current_run
systemd/run.env

# python venv and caches
.venv/
__pycache__/
*.pyc
